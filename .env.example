# Copy this file to .env before running `docker compose up`.
#
# API_KEY_HASH is the SHA-256 hex digest of the raw API key clients will send in
# the X-Api-Key header. Never put the raw key here — only its hash.
#
# The value below is the hash of "dev-local-key" (the same key documented in the
# README for local development). Generate your own for anything beyond local use:
#   printf 'your-key-here' | shasum -a 256 | tr '[:lower:]' '[:upper:]'
API_KEY_HASH=3700285E3C8496A57E45EB1CCD43F2424852788576961320FBB31F86F17EDB61
